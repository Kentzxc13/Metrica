# ==============================================================================
# Metrica Environment Variables Template
# Copy these keys into your Vercel Project Settings -> Environment Variables
# ==============================================================================

# Supabase Configuration
# Required: Needed for realtime subscriptions and database queries
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-public-key"

# Required for server-side API routes (/api/payments, /api/captable, /api/ledger)
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# Stripe Webhooks Configuration
# Required: Needed for Stripe Webhook verification (/api/webhooks/stripe)
STRIPE_WEBHOOK_SECRET="whsec_your_stripe_webhook_secret"

# Optional: Set to 'true' in production to enforce strict Stripe signature verification
WEBHOOK_STRICT_MODE="false"
